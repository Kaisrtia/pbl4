    "/api/defense/status": {
      "get": {
        "description": "Trả về trạng thái của Master Shield và các cờ con: anti_sqli, rate_limit, input_sanitization.",
        "operationId": "DefenseController_getStatus",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Lấy trạng thái thành công"
          }
        },
        "summary": "Lấy trạng thái Khiên L3 hiện tại",
        "tags": [
          "Defense"
        ]
      }
    },
    "/api/defense/toggle": {
      "post": {
        "description": "Gửi body rỗng `{}` để đảo toàn bộ Master L3 (bật/tắt cả 3 khiên con), hoặc gửi `{ \"flag\": \"anti_sqli\" }` để đảo riêng 1 khiên con.",
        "operationId": "DefenseController_toggle",
        "parameters": [],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "flag": {
                    "type": "string",
                    "enum": [
                      "anti_sqli",
                      "rate_limit",
                      "input_sanitization"
                    ],
                    "description": "Cờ con muốn toggle riêng (bỏ trống để toggle Master L3)"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Đã đảo trạng thái khiên thành công"
          }
        },
        "summary": "Bật / Tắt Khiên L3 (Nút Lab Control)",
        "tags": [
          "Defense"
        ]
      }
    },
    "/api/defense/set": {
      "post": {
        "operationId": "DefenseController_setFlags",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Cập nhật cờ thành công"
          }
        },
        "summary": "Gán trạng thái cụ thể cho các cờ phòng thủ",
        "tags": [
          "Defense"
        ]
      }
    },
    "/api/auth/login": {
      "post": {
        "description": "Khi Khiên L3 TẮT: Hỗ trợ bypass SQL Injection với payload `admin' --`. Khi Khiên L3 BẬT: Sử dụng Prepared Statement và chặn mã 401.",
        "operationId": "AuthController_login",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Đăng nhập thành công, trả về access_token 30 ngày."
          },
          "401": {
            "description": "Tài khoản hoặc mật khẩu không chính xác (hoặc bị Khiên L3 chặn đứng)."
          },
          "429": {
            "description": "Bị giới hạn tần suất gửi yêu cầu (Rate Limit)."
          }
        },
        "summary": "Đăng nhập người dùng & Cấp JWT 30 ngày",
        "tags": [
          "Authentication"
        ]
      }
    },
    "/api/auth/profile": {
      "get": {
        "description": "Yêu cầu Bearer JWT Token hợp lệ trong Header Authorization. Trả về mã 401 nếu chưa đăng nhập hoặc token đã hết hạn.",
        "operationId": "AuthController_getProfile",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Xác thực JWT thành công, trả về thông tin người dùng."
          },
          "401": {
            "description": "Chưa đăng nhập, thiếu token hoặc token không hợp lệ."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Lấy thông tin tài khoản người dùng đang đăng nhập",
        "tags": [
          "Authentication"
        ]
      }
    },
    "/api/auth/me": {
      "get": {
        "operationId": "AuthController_getMe",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Alias cho endpoint GET /api/auth/profile",
        "tags": [
          "Authentication"
        ]
      }
    },
    "/api/reports/analytics": {
      "get": {
        "description": "Chạy lặp băm SHA-256 từ 1.000 đến 2.000.000 vòng để tiêu tốn chu kỳ CPU máy chủ mục tiêu. Được bảo vệ bởi DynamicRateLimitGuard khi Khiên L3 bật.",
        "operationId": "ReportsController_getAnalytics",
        "parameters": [
          {
            "name": "iterations",
            "required": false,
            "in": "query",
            "description": "Số vòng lặp băm SHA-256 (mặc định 100.000)",
            "schema": {
              "example": 100000,
              "type": "string"
            }
          },
          {
            "name": "delay_ms",
            "required": false,
            "in": "query",
            "description": "Độ trễ giả lập nhân tạo (ms, tối đa 5000ms)",
            "schema": {
              "example": 0,
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Tính toán hoàn tất"
          },
          "429": {
            "description": "Bị Rate Limit chặn đứng"
          }
        },
        "summary": "Tác vụ tính toán CPU nặng (Mô phỏng L7 DoS)",
        "tags": [
          "Reports"
        ]
      }
    },
    "/api/reports/heavy": {
      "post": {
        "operationId": "ReportsController_postHeavyLoad",
        "parameters": [],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "iterations": {
                    "type": "number",
                    "example": 100000
                  },
                  "delay_ms": {
                    "type": "number",
                    "example": 0
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Tính toán hoàn tất"
          },
          "429": {
            "description": "Bị Rate Limit chặn đứng"
          }
        },
        "summary": "Tác vụ CPU nặng qua phương thức POST",
        "tags": [
          "Reports"
        ]
      }
    },
    "/api/files/download": {
      "get": {
        "description": "Khi Khiên L3 BẬT: Chặn các payload chứa `..`, `/`, `\\` (mã lỗi 400 Bad Request). Khi Khiên L3 TẮT: Nối chuỗi đường dẫn trực tiếp cho phép đọc file tùy ý.",
        "operationId": "FilesController_downloadFile",
        "parameters": [
          {
            "name": "name",
            "required": true,
            "in": "query",
            "description": "Tên file cần tải (Thử payload `../../etc/passwd` để test Path Traversal)",
            "schema": {
              "example": "sample_report.txt",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Tải file thành công"
          },
          "400": {
            "description": "Bị Khiên Input Sanitization chặn đứng"
          },
          "404": {
            "description": "Không tìm thấy file"
          }
        },
        "summary": "Tải file công khai (Mô phỏng tấn công Path Traversal)",
        "tags": [
          "Files"
        ]
      }
    },
    "/api/system/ping": {
      "get": {
        "description": "Gửi timestamp của client để server tính toán độ trễ mili-giây (latency_ms) phục vụ đo lường trước/trong khi bị tấn công DoS.",
