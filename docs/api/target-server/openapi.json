              "type": "string"
            }
          },
          {
            "name": "echo",
            "required": false,
            "in": "query",
            "description": "Chuỗi thông điệp phản hồi",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Phản hồi pong thành công"
          }
        },
        "summary": "Đo độ trễ phản hồi (Latency Ping)",
        "tags": [
          "System"
        ]
      }
    },
