# ==============================================================================
# TARGET SERVER (BACKEND NESTJS) - ENVIRONMENT CONFIGURATION
# Project: PBL4 - DevSecOps & Plaintext Network Defense System
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. MẠNG & MÁY CHỦ (SERVER NETWORK & RUNTIME)
# ------------------------------------------------------------------------------
PORT=8000
NODE_ENV=development
# Danh sách domain được phép gọi API (dấu * cho phép mọi nguồn, hoặc http://localhost:3000)
CORS_ORIGIN=*

# ------------------------------------------------------------------------------
# 2. XÁC THỰC BẢO MẬT JWT (AUTHENTICATION & TOKENS)
# ------------------------------------------------------------------------------
# Khóa bí mật dùng để ký và xác thực token JWT
JWT_SECRET=pbl4_devsec_super_secret_jwt_key_2026!
# Thời gian hết hạn của Access Token (vd: 30d = 30 ngày, 1h, 15m)
JWT_EXPIRES_IN=30d

# ------------------------------------------------------------------------------
# 3. CƠ SỞ DỮ LIỆU & LƯU TRỮ TẬP TIN (STORAGE & DATABASE)
# ------------------------------------------------------------------------------
# Đường dẫn file SQLite (hỗ trợ :memory: khi chạy test)
DATABASE_PATH=./data/devsec.sqlite
# Thời gian chờ mở khóa SQLite khi có nhiều luồng cùng ghi (milliseconds)
DB_BUSY_TIMEOUT_MS=5000
# Thư mục lưu trữ tài liệu kỹ thuật / file công khai
PUBLIC_FILES_DIR=./data/public

# ------------------------------------------------------------------------------
# 4. KHIÊN PHÒNG THỦ L3 - TRẠNG THÁI KHỞI TẠO (DEFENSE L3 INITIAL STATE)
# (false = TẮT để mô phỏng bị tấn công, true = BẬT để phòng thủ)
# ------------------------------------------------------------------------------
DEFENSE_L3_ENABLED=false
DEFENSE_ANTI_SQLI=false
DEFENSE_RATE_LIMIT=false
DEFENSE_INPUT_SANITIZATION=false

# ------------------------------------------------------------------------------
# 5. CẤU HÌNH NGƯỠNG RATE LIMITING (KHI BẬT KHIÊN L3)
# ------------------------------------------------------------------------------
# Khoảng thời gian cửa sổ trượt (milliseconds)
RATE_LIMIT_WINDOW_MS=5000
# Số request tối đa cho phép trong mỗi cửa sổ trượt trước khi chặn (HTTP 429)
RATE_LIMIT_MAX_REQUESTS=10

# ------------------------------------------------------------------------------
# 6. TRẠM GIÁM SÁT MẠNG GOD-VIEW (TELEMETRY & INGESTION HUB)
# ------------------------------------------------------------------------------
# Địa chỉ nhận log telemetry:
# - Local dev: http://localhost:4000/api/telemetry
# - Docker net: http://172.20.0.99:4000/api/telemetry
GODVIEW_TELEMETRY_URL=http://localhost:4000/api/telemetry
# Thời gian chờ tối đa khi gửi gói tin telemetry (tránh nghẽn Target Server, milliseconds)
GODVIEW_TIMEOUT_MS=1000
