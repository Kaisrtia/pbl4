# Auto-detect text files and perform LF normalization on check-in
* text=auto eol=lf

# Explicitly ensure LF line endings to avoid Docker / Linux execution errors
*.sh text eol=lf
*.bash text eol=lf
*.py text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.jsx text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
Dockerfile* text eol=lf
.env* text eol=lf

# Binary files
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.pcap binary
*.pcapng binary
