# Run config is immutable while the controller is running. Restart after editing.
ATTACKER_BIND=127.0.0.1
HACKER_API_PORT=9000
HACKER_IP=172.20.0.66
SERVER_IP=172.20.0.20
SERVER_PORT=8000
TARGET_SSH_PORT=22
GODVIEW_TELEMETRY_URL=http://172.20.0.99:8080/api/events/attack
EXFIL_RECEIVER_PORT=9001
RECEIVER_BIND=0.0.0.0
# Required (>=16 chars) if binding the controller to 0.0.0.0.
ATTACKER_API_TOKEN=
LAB_SSH_USER=lab
LAB_SANDBOX=/home/lab/pbl4-lab
LAB_KNOWN_HOSTS=/run/lab-secrets/known_hosts
LAB_SSH_KEY_FILE=/run/lab-secrets/id_ed25519
# Optional: one configured password attempt instead of key authentication.
LAB_SSH_PASSWORD_FILE=
# Native development can set PYTHON_BIN to .venv/bin/python.
PYTHON_BIN=python3
