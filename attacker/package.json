{
  "name": "@pbl4/attacker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "cli": "tsx src/cli.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:python": "python3 -m unittest discover -s tests -p 'test_*.py'",
    "test:integration": "node tests/docker-integration.mjs"
  },
  "devDependencies": {
    "@types/node": "22.19.15",
    "ajv": "8.20.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
