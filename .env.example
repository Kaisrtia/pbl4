# ==============================================================================
# Cyber Attack Simulation & Monitoring System (God-View) - Environment Template
# ==============================================================================

# --- Docker Network Configuration ---
DOCKER_NETWORK_NAME=cybersec-net
DOCKER_SUBNET=172.20.0.0/24
DOCKER_GATEWAY=172.20.0.1

# --- Node Static IP Addresses (As per Milestone 1 Architecture) ---
CLIENT_IP=172.20.0.10
SERVER_IP=172.20.0.20
HACKER_IP=172.20.0.66
GODVIEW_IP=172.20.0.99

# --- Port Configurations ---
# Target Server Web App (Port exposed to host if needed)
SERVER_PORT=8000

# God-View Monitor Node
GODVIEW_BACKEND_PORT=8080
GODVIEW_FRONTEND_PORT=3000

# Hacker C2 / Trigger API (Optional)
HACKER_API_PORT=9000

# --- Telemetry & Monitoring Settings ---
TELEMETRY_INTERVAL_MS=500
LOG_LEVEL=INFO

# --- Defense Mode Toggles (Defaults for Lab Testing) ---
# Layer 1: Network (Static ARP, iptables)
DEFENSE_L1_NETWORK=false

# Layer 2: OS/Kernel (tcp_syncookies, ulimit, cgroups)
DEFENSE_L2_OS=false

# Layer 3: Application (API Rate Limiting, Input Sanitization)
DEFENSE_L3_APP=false
